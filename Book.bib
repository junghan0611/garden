@book{book-findingflowpsychology08,
  title = {Finding Flow: The Psychology of Engagement with Everyday Life},
  shorttitle = {Finding Flow},
  author = {{Mihaly Csikszentmihalyi}},
  date = {1998},
  location = {New York, NY},
  url = {https://oceanofpdf.com/authors/mihaly-csikszentmihalyi/pdf-epub-finding-flow-the-psychology-of-engagement-with-everyday-life-download-46990752162/},
  abstract = {From the bestselling author of Flow and one of the pioneers of the scientific study of happiness, an indispensable guide to living your best life. What makes a good life? Is it money? An important job? Leisure time? Mihaly Csikszentmihalyi believes our obsessive focus on such measures has led us astray. Work fills our days with anxiety and pressure, so that during our free time, we tend to live in boredom, absorbed by our screens.무엇이 좋은 삶을 만들까요? 돈일까요? 중요한 직업? 여가 시간? 미할리 칙센트미할리는 이러한 척도에 대한 강박적인 집착이 우리를 잘못된 길로 이끌었다고 생각합니다. 일 때문에 하루를 불안과 압박감으로 가득 채우고, 여가 시간에는 지루함을 느끼며 스크린에 몰두하는 경향이 있습니다. What are we missing? To answer this question, Csikszentmihalyi studied thousands of people, and he found the key. People are happiest when they challenge themselves with tasks that demand a high degree of skill and commitment, and which are undertaken for their own sake. Instead of scrolling on your phone, play the piano. Take a routine chore and figure out how to do it better, faster, more efficiently. In short, learn the hidden power of complete engagement, a psychological state the author calls~flow. Though they appear simple, the lessons in~우리가 놓치고 있는 것은 무엇일까요? 이 질문에 답하기 위해 수천 명의 사람들을 연구한 칙센트미하이가 그 열쇠를 찾았습니다. 사람들은 고도의 기술과 헌신이 필요하고 자신을 위해 수행하는 일에 도전할 때 가장 행복합니다. 휴대폰으로 스크롤을 하는 대신 피아노를 연주해 보세요. 일상적인 집안일을 하면서 더 빠르고 효율적으로 더 잘할 수 있는 방법을 찾아보세요. 요컨대, 저자가 플로우라고 부르는 심리적 상태인 완전한 몰입의 숨겨진 힘을 배워보세요. 간단해 보이지만, 이 책에 담긴 교훈은Finding Flow~are life-changing.},
